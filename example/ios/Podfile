ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-test-app/test_app.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-test-app/test_app.rb"

workspace 'WifiAwareExample.xcworkspace'

use_test_app! :hermes_enabled => true,
              :fabric_enabled => true,
              :post_install => proc { |_installer|
                # react-native-test-app regenerates this host project on every
                # `pod install`. Reapply the example-only, static Apple service
                # declaration after generation; consumer apps configure their
                # own host target as documented by the library.
                info_plist = File.join(__dir__, 'ReactTestApp', 'Info.plist')
                next unless File.exist?(info_plist)

                info = Xcodeproj::Plist.read_from_path(info_plist)
                info['WiFiAwareServices'] = {
                  '_rn-aware._tcp' => {
                    'Publishable' => {},
                    'Subscribable' => {},
                  },
                }
                Xcodeproj::Plist.write_to_path(info, info_plist)
              }
